<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="4dp" android:background="@drawable/widget_bg">

    <!-- Header: JADWAL SHIFT: Hari, Tanggal ............ Jam 11:23 -->
    <LinearLayout android:id="@+id/w_header" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingLeft="6dp" android:paddingRight="6dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:background="#1E293B">
        <TextView android:id="@+id/w_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="JADWAL SHIFT: " android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" android:singleLine="true"/>
        <TextClock android:id="@+id/w_date" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:format12Hour="EEEE, dd MMM" android:format24Hour="EEEE, dd MMM"
            android:singleLine="true" android:ellipsize="end" android:textColor="#FACC15" android:textSize="11sp" android:textStyle="bold"/>
        <TextView android:id="@+id/w_time_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Jam " android:textColor="#94A3B8" android:textSize="11sp" android:textStyle="bold"/>
        <TextClock android:id="@+id/w_time" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:format12Hour="HH:mm" android:format24Hour="HH:mm" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold"/>
    </LinearLayout>

    <!-- Judul kolom: DUTY | NEXT -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="3dp">
        <TextView android:id="@+id/w_h_duty" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.7"
            android:layout_marginRight="2dp" android:paddingLeft="6dp" android:paddingTop="2dp" android:paddingBottom="2dp"
            android:background="#1E293B" android:textColor="#FFFFFF" android:textSize="10sp" android:textStyle="bold" android:text="DUTY"/>
        <TextView android:id="@+id/w_h_next" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:paddingLeft="6dp" android:paddingTop="2dp" android:paddingBottom="2dp"
            android:background="#1E293B" android:textColor="#FFFFFF" android:textSize="10sp" android:textStyle="bold" android:text="NEXT"/>
    </LinearLayout>

    <!-- Isi: 3 baris Duty (kiri) dan 3 baris Next (kanan) -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="horizontal" android:layout_marginTop="2dp">
        <LinearLayout android:id="@+id/duty_col" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.7"
            android:layout_marginRight="2dp" android:orientation="vertical" android:background="#2563EB">
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:paddingLeft="6dp" android:paddingRight="6dp">
                <TextView android:id="@+id/duty_name1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:singleLine="true" android:ellipsize="end" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" android:text=""/>
                <TextView android:id="@+id/duty_time1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingLeft="4dp" android:singleLine="true" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" android:text=""/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:paddingLeft="6dp" android:paddingRight="6dp">
                <TextView android:id="@+id/duty_name2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:singleLine="true" android:ellipsize="end" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" android:text=""/>
                <TextView android:id="@+id/duty_time2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingLeft="4dp" android:singleLine="true" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" android:text=""/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:paddingLeft="6dp" android:paddingRight="6dp">
                <TextView android:id="@+id/duty_name3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:singleLine="true" android:ellipsize="end" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" android:text=""/>
                <TextView android:id="@+id/duty_time3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingLeft="4dp" android:singleLine="true" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" android:text=""/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/next_col" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:orientation="vertical" android:background="#FACC15">
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:paddingLeft="6dp" android:paddingRight="6dp">
                <TextView android:id="@+id/next_name1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:singleLine="true" android:ellipsize="end" android:textColor="#0F172A" android:textSize="11sp" android:textStyle="bold" android:text=""/>
                <TextView android:id="@+id/next_time1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingLeft="4dp" android:singleLine="true" android:textColor="#0F172A" android:textSize="11sp" android:textStyle="bold" android:text=""/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:paddingLeft="6dp" android:paddingRight="6dp">
                <TextView android:id="@+id/next_name2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:singleLine="true" android:ellipsize="end" android:textColor="#0F172A" android:textSize="11sp" android:textStyle="bold" android:text=""/>
                <TextView android:id="@+id/next_time2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingLeft="4dp" android:singleLine="true" android:textColor="#0F172A" android:textSize="11sp" android:textStyle="bold" android:text=""/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:paddingLeft="6dp" android:paddingRight="6dp">
                <TextView android:id="@+id/next_name3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:singleLine="true" android:ellipsize="end" android:textColor="#0F172A" android:textSize="11sp" android:textStyle="bold" android:text=""/>
                <TextView android:id="@+id/next_time3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingLeft="4dp" android:singleLine="true" android:textColor="#0F172A" android:textSize="11sp" android:textStyle="bold" android:text=""/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
