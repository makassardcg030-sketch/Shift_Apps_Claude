<receiver android:name="org.shiftapp.shiftapp.ShiftWidgetProvider" android:label="Jadwal Shift (Tim)" android:exported="true">
    <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
    </intent-filter>
    <meta-data android:name="android.appwidget.provider" android:resource="@xml/shift_widget_info"/>
</receiver>

<receiver android:name="org.shiftapp.shiftapp.PersonalWidgetProvider" android:label="Jadwal Personal + Alarm" android:exported="true">
    <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
    </intent-filter>
    <meta-data android:name="android.appwidget.provider" android:resource="@xml/personal_widget_info"/>
</receiver>

<activity android:name="org.shiftapp.shiftapp.PersonalWidgetConfigActivity"
    android:label="Pilih Nama Jadwal"
    android:theme="@android:style/Theme.DeviceDefault.Dialog"
    android:exported="true">
    <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE"/>
    </intent-filter>
</activity>
